[{"i":"1846459680056856578","no":1,"t":2,"s":"<p><span style=\"font-family: 宋体;\">请查看第二大题“实际操作”再进行本题作答</span></p><p><span style=\"font-family: 宋体;\">1. 凸轮机构由下列哪些零部件构成？（ ）</span></p>","o":[{"l":"A","c":"<p><span style=\"font-family: 宋体;\">机架或机座</span></p>"},{"l":"B","c":"<p><span style=\"font-family: 宋体;\">凸轮</span></p>"},{"l":"C","c":"<p><span style=\"font-family: 宋体;\">从动件</span></p>"},{"l":"D","c":"<p><span style=\"font-family: 宋体;\">曲柄</span></p>"}],"a":"A,C,B","an":"<p><br></p>","sc":4.0,"kp":["凸轮、滑杆、棘轮、曲柄、连杆等特殊结构","凸轮机构中从动件的运动轨迹"]},{"i":"1846459796995874818","no":2,"t":2,"s":"<p><span style=\"font-family: 宋体;\">凸轮机构按照凸轮的形状分为？（ ）</span></p>","o":[{"l":"A","c":"<p><span style=\"font-family: 宋体;\">盘形凸轮</span></p>"},{"l":"B","c":"<p><span style=\"font-family: 宋体;\">移动凸轮</span></p>"},{"l":"C","c":"<p><span style=\"font-family: 宋体;\">圆形凸轮</span></p>"},{"l":"D","c":"<p><span style=\"font-family: 宋体;\">圆柱凸轮</span></p>"}],"a":"A,D,B","an":"<p><br></p>","sc":4.0,"kp":["凸轮、滑杆、棘轮、曲柄、连杆等特殊结构","凸轮机构中从动件的运动轨迹"]},{"i":"1846459884550148098","no":3,"t":2,"s":"<p><span style=\"font-family: 宋体;\">乌龟模型采用的零部件或机构有哪些？（ ）</span></p>","o":[{"l":"A","c":"<p><span style=\"font-family: 宋体;\">机架</span></p>"},{"l":"B","c":"<p><span style=\"font-family: 宋体;\">凸轮机构</span></p>"},{"l":"C","c":"<p><span style=\"font-family: 宋体;\">滑轮</span></p>"},{"l":"D","c":"<p><span style=\"font-family: 宋体;\">斜面</span></p>"}],"a":"A,B","an":"<p><br></p>","sc":4.0,"kp":["凸轮、滑杆、棘轮、曲柄、蜗轮蜗杆等特殊结构在生活中的应用","凸轮、滑杆、棘轮、曲柄、连杆等特殊结构"]},{"i":"1846460866315079681","no":4,"t":2,"s":"<p><span style=\"font-family: 宋体;\">关于凸轮机构中从动件的运动说法正确的有？（ ）</span></p>","o":[{"l":"A","c":"<p><span style=\"font-family: 宋体;\">从动件的运动轨迹与凸轮的轮廓曲线无关</span></p>"},{"l":"B","c":"<p><span style=\"font-family: 宋体;\">从动件的运动轨迹与凸轮的轮廓曲线有关</span></p>"},{"l":"C","c":"<p><span style=\"font-family: 宋体;\">从动件的运动周期与凸轮的运动周期无关</span></p>"},{"l":"D","c":"<p><span style=\"font-family: 宋体;\">从动件的运动周期与凸轮的运动周期有关</span></p>"}],"a":"B,D","an":"<p><br></p>","sc":4.0,"kp":["凸轮机构中从动件的运动轨迹","凸轮、滑杆、棘轮、曲柄、连杆等特殊结构"]},{"i":"1846461548545232898","no":5,"t":4,"s":"<p><strong>实操考题</strong></p><p style=\"text-indent: 28.1pt;\"><strong>搭建说明</strong><span style=\"font-family: 宋体;\">：请考生制作一个电动乌龟模型。</span></p><p style=\"text-indent: 28.1pt;\"><strong>搭建要求：</strong></p><p><span style=\"font-family: 宋体;\">(a)具备电动乌龟模型大体框架；<br>(b)任选一种传动方式；<br>(c)用凸轮机构表示乌龟的脚；<br>(d)开启电动机，乌龟能向前爬动；</span></p><p><span style=\"font-family: 宋体;\">(e)整体动作流畅。</span></p><p style=\"text-indent: 28.1pt;\"><strong>器材说明：</strong></p><p style=\"text-indent: 28pt;\"><span style=\"font-family: 宋体;\">考生作答时不指定任何器材，所搭建的模型在外形、结构、功能方面满足题目要求即可。以下样例模型选自经中国电子学会评审通过的青少年机器人技术等级考试一级、二级适用器材。仅供参考，不作为考试评分的唯一依据。<br></span><strong> &nbsp; &nbsp;案例样图：</strong></p><p style=\"text-indent: 28pt;\"><span style=\"font-family: 宋体;\">以下列举了相关器材模型样例，考生可任选其一作为参考。</span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例1</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2024-10-16-16-00-39/样例1.jpg\" alt=\"\" data-href=\"\" style=\"\"></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例2</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2024-10-16-16-00-57/样例2.jpg\" alt=\"\" data-href=\"\" style=\"\"></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例3</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2024-10-16-16-01-13/样例3.jpg\" alt=\"\" data-href=\"\" style=\"\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例4</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2024-10-16-16-01-28/样例4.jpg\" alt=\"\" data-href=\"\" style=\"\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例5</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2024-10-16-16-01-41/样例5.jpg\" alt=\"\" data-href=\"\" style=\"\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例6</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2024-10-16-16-01-52/样例6.jpg\" alt=\"\" data-href=\"\" style=\"\"></p><p><span style=\"font-family: 宋体;\"> </span></p><p><img src=\"file:///C:\\Users\\ADMINI~1\\AppData\\Local\\Temp\\ksohtml6004\\wps12.png\" alt=\"\" data-href=\"\" style=\"\"/><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-indent: 28pt;\"><br></p>","o":[],"a":"","an":"<p><br></p>","sc":80.0,"kp":["凸轮、滑杆、棘轮、曲柄、蜗轮蜗杆等特殊结构在生活中的应用","凸轮机构中从动件的运动轨迹","电机的工作原理","熟练连接独立的电池盒、开关以及电机","电机的应用，能够连接电机完成一定任务，完成旋转、往复、摇摆等动作","凸轮、滑杆、棘轮、曲柄、连杆等特殊结构"]}]