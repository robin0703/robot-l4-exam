[{"i":"1876178852992688130","no":1,"t":2,"s":"<p><span style=\"font-family: 宋体;\">本题为多选题，请查看第二大题“实际操作”再进行本题作答。</span></p><p><span style=\"font-family: 宋体;\">1. 下列能增强模型稳定性的做法有哪些？（ ）</span></p>","o":[{"l":"A","c":"<p><span style=\"font-family: 宋体;\">多采用三角形结构</span></p>"},{"l":"B","c":"<p><span style=\"font-family: 宋体;\">使模型与地面的接触面积增大</span></p>"},{"l":"C","c":"<p><span style=\"font-family: 宋体;\">多采用四边形结构</span></p>"},{"l":"D","c":"<p><span style=\"font-family: 宋体;\">使模型与地面的接触面积减小</span></p>"}],"a":"A,B","an":"<p><br></p>","sc":4.0,"kp":["稳定结构和不稳定结构的特性","基本结构认知"]},{"i":"1876178950694424577","no":2,"t":2,"s":"<p><span style=\"font-family: 宋体;\">关于手摇把手说法正确的有？（ ）</span></p>","o":[{"l":"A","c":"<p><span style=\"font-family: 宋体;\">是轮轴省力的应用</span></p>"},{"l":"B","c":"<p><span style=\"font-family: 宋体;\">是轮轴费力的应用</span></p>"},{"l":"C","c":"<p><span style=\"font-family: 宋体;\">是杠杆的变形</span></p>"},{"l":"D","c":"<p><span style=\"font-family: 宋体;\">是滑轮的变形</span></p>"}],"a":"A,C","an":"<p><br></p>","sc":4.0,"kp":["省力杠杆和费力杠杆","六种简单机械原理（杠杆，轮轴，滑轮，斜面，楔，螺旋）"]},{"i":"1876179063844544514","no":3,"t":2,"s":"<p><span style=\"font-family: 宋体;\">关于烤肉架模型说法正确的是？（ ）</span></p>","o":[{"l":"A","c":"<p><span style=\"font-family: 宋体;\">平行啮合的两个相邻的齿轮转向相同</span></p>"},{"l":"B","c":"<p><span style=\"font-family: 宋体;\">平行啮合的两个相邻的齿轮转向相反</span></p>"},{"l":"C","c":"<p><span style=\"font-family: 宋体;\">齿轮越大，它的旋转中心轴转的越慢</span></p>"},{"l":"D","c":"<p><span style=\"font-family: 宋体;\">齿轮越大，它的旋转中心轴转的越快</span></p>"}],"a":"B,C","an":"<p><br></p>","sc":4.0,"kp":["齿轮组变速比例的计算","齿轮和齿轮比的概念"]},{"i":"1876179210240708610","no":4,"t":2,"s":"<p><span style=\"font-family: 宋体;\">关于齿轮传动说法正确的有？（ ）</span></p>","o":[{"l":"A","c":"<p><span style=\"font-family: 宋体;\">大齿轮带动小齿轮起加速作用</span></p>"},{"l":"B","c":"<p><span style=\"font-family: 宋体;\">大齿轮带动小齿轮起减速作用</span></p>"},{"l":"C","c":"<p><span style=\"font-family: 宋体;\">所有齿轮组的传动比都是1:1</span></p>"},{"l":"D","c":"<p><span style=\"font-family: 宋体;\">两个同样大小的齿轮啮合传动比是1:1</span></p>"}],"a":"A,D","an":"<p><br></p>","sc":4.0,"kp":["齿轮组变速比例的计算","齿轮和齿轮比的概念"]},{"i":"1876179571757600770","no":5,"t":4,"s":"<p><span style=\"font-family: 宋体;\">实际操作(共1题，共80分)</span></p><p><span style=\"font-family: 宋体;\">5. </span></p><p><span style=\"font-family: 宋体;\">搭建说明：</span></p><p><span style=\"font-family: 宋体;\">请考生制作一个手动烤肉架模型。</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">搭建要求：</span></p><p><span style=\"font-family: 宋体;\">(a) 具备手动烤肉架模型大体框架；</span></p><p><span style=\"font-family: 宋体;\">(b) 具备依次啮合的齿轮（至少三个）；</span></p><p><span style=\"font-family: 宋体;\">(c) 具备手摇把手，每个齿轮上有一个长轴表示用于烤肉的部件；</span></p><p><span style=\"font-family: 宋体;\">(d) 缓慢旋转手摇把手，各长轴旋转；</span></p><p><span style=\"font-family: 宋体;\">(e) 整体动作流畅。</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">评分项：</span></p><p><span style=\"font-family: 宋体;\">1. 整体框架（40分）</span></p><p><span style=\"font-family: 宋体;\">(1) 作品零件结构和样例模型基本一致，结构完整；（20分）</span></p><p><span style=\"font-family: 宋体;\">(2) 作品相应部件固定可靠；（10分）</span></p><p><span style=\"font-family: 宋体;\">(3) 作品整体协调美观。（10分）</span></p><p><span style=\"font-family: 宋体;\">2. 动力传递/表现形式（30分）</span></p><p><span style=\"font-family: 宋体;\">(1) 完整实现题目要求的动作；（15分）</span></p><p><span style=\"font-family: 宋体;\">(2) 作品整体动作顺利流畅。（15分）</span></p><p><span style=\"font-family: 宋体;\">3. 完成时间（10分）</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">器材说明：</span></p><p><span style=\"font-family: 宋体;\">考生作答时不指定任何器材，所搭建的模型在外形、结构、功能方面满足题目要求即可。以下样例模型选自经中国电子学会评审通过的青少年机器人技术等级考试一级、二级适用器材。仅供参考，不作为考试评分的唯一依据。</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">案例样图：</span></p><p><span style=\"font-family: 宋体;\">以下列举了相关器材模型样例，考生可任选其一作为参考。</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例1</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-01-06-16-09-44/样例1.jpg\" alt=\"\" data-href=\"\" style=\"\"><img src=\"file:///C:\\Users\\ADMINI~1\\AppData\\Local\\Temp\\ksohtml16972\\wps1.png\" alt=\"\" data-href=\"\" style=\"\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例2</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-01-06-16-09-50/样例2.jpg\" alt=\"\" data-href=\"\" style=\"\"><img src=\"file:///C:\\Users\\ADMINI~1\\AppData\\Local\\Temp\\ksohtml16972\\wps2.png\" alt=\"\" data-href=\"\" style=\"\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例3</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-01-06-16-09-57/样例3.jpg\" alt=\"\" data-href=\"\" style=\"\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><img src=\"file:///C:\\Users\\ADMINI~1\\AppData\\Local\\Temp\\ksohtml16972\\wps3.png\" alt=\"\" data-href=\"\" style=\"\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例4</span></p><p style=\"text-align: center;\"><img src=\"file:///C:\\Users\\ADMINI~1\\AppData\\Local\\Temp\\ksohtml16972\\wps4.png\" alt=\"\" data-href=\"\" style=\"\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-01-06-16-10-02/样例4.jpg\" alt=\"\" data-href=\"\" style=\"\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例5</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-01-06-16-10-09/样例5.jpg\" alt=\"\" data-href=\"\" style=\"\"><img src=\"file:///C:\\Users\\ADMINI~1\\AppData\\Local\\Temp\\ksohtml16972\\wps5.png\" alt=\"\" data-href=\"\" style=\"\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例6</span></p><p><img src=\"file:///C:\\Users\\ADMINI~1\\AppData\\Local\\Temp\\ksohtml16972\\wps6.png\" alt=\"\" data-href=\"\" style=\"\"/><span style=\"font-family: 宋体;\"> </span><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-01-06-16-10-18/样例6.jpg\" alt=\"\" data-href=\"\" style=\"\"/></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p> </p>","o":[],"a":"","an":"<p><span style=\"font-family: 宋体;\">评分说明</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">1、整体框架（40分）</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">(1) 作品零件结构是否和样例模型基本一致、结构完整，具备①手摇把手、②三个齿轮及以上构成的依次啮合的齿轮组、③有三根及以上长轴表示烤肉的部件，以上每缺少一点扣10分，缺少两点及两点以上扣20分。（20分）</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">(2) 作品相应部件的固定可靠程度；（10分）</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">(3) 作品的整体协调性和美观性。（10分）</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">2、动力传递/表现形式（30分）</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">(1) 摇动手摇把手，所有的“烤肉棍”旋转；（15分）</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">(2) 作品整体动作顺利流畅。（15分）</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">3、完成时间（10分）</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">在考试时间内完成得10分，超时1分钟扣1分。（10分）</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">超时10分钟以上不结束操作总成绩记为0分。</span></p>","sc":80.0,"kp":["齿轮组变速比例的计算","齿轮和齿轮比的概念","基本结构认知"]}]