[{"i":"1971462540550500353","no":1,"t":2,"s":"<p style=\"text-align: center;\"><strong>分数：100 &nbsp;题数：5</strong></p><p><span style=\"font-family: 宋体;\">一、模型认知(共4题，共20分)</span></p><p><span style=\"font-family: 宋体;\">参考第二大题的实际操作题，回答下列问题。</span></p><p><span style=\"font-family: 宋体;\">1. 关于模型中的手摇把手说法正确的是？（ ）</span></p>","o":[{"l":"A","c":"<p><span style=\"font-family: 宋体;\">手柄越长越省力</span></p>"},{"l":"B","c":"<p><span style=\"font-family: 宋体;\">相当于费力杠杆</span></p>"},{"l":"C","c":"<p><span style=\"font-family: 宋体;\">相当于省力杠杆</span></p>"},{"l":"D","c":"<p><span style=\"font-family: 宋体;\">相当于等臂杠杆</span></p>"}],"a":"A,C","an":"<p><br></p>","sc":4.0,"kp":["省力杠杆和费力杠杆","六种简单机械原理（杠杆，轮轴，滑轮，斜面，楔，螺旋）"]},{"i":"1971462651494035458","no":2,"t":2,"s":"<p><span style=\"font-family: 宋体;\">在搭建奇怪的时钟模型时，下列说法正确的2项是？（ ）</span></p>","o":[{"l":"A","c":"<p><span style=\"font-family: 宋体;\">时针和分针不可能固定在同轴齿轮上</span></p>"},{"l":"B","c":"<p><span style=\"font-family: 宋体;\">固定时针和分针的齿轮有可能是同轴齿轮</span></p>"},{"l":"C","c":"<p><span style=\"font-family: 宋体;\">模型一定会采用冠齿轮</span></p>"},{"l":"D","c":"<p><span style=\"font-family: 宋体;\">固定时针和分针时要注意选择合适的长度以免在旋转过程中被其他零件卡住</span></p>"}],"a":"A,D","an":"<p><br></p>","sc":4.0,"kp":["齿轮组变速比例的计算","齿轮和齿轮比的概念"]},{"i":"1971462798277898242","no":3,"t":2,"s":"<p><span style=\"font-family: 宋体;\">关于齿轮啮合下列说法正确的有？（ ）</span></p>","o":[{"l":"A","c":"<p><span style=\"font-family: 宋体;\">主动轮大于从动轮起加速作用</span></p>"},{"l":"B","c":"<p><span style=\"font-family: 宋体;\">主动轮大于从动轮起减速作用</span></p>"},{"l":"C","c":"<p><span style=\"font-family: 宋体;\">平行啮合的两轮转向相反</span></p>"},{"l":"D","c":"<p><span style=\"font-family: 宋体;\">平行啮合的两轮转向相同</span></p>"}],"a":"A,C","an":"<p><br></p>","sc":4.0,"kp":["齿轮组变速比例的计算","齿轮和齿轮比的概念"]},{"i":"1971462901407444993","no":4,"t":2,"s":"<p><span style=\"font-family: 宋体;\">关于齿轮传动的特点说法正确的有？（ ）</span></p>","o":[{"l":"A","c":"<p><span style=\"font-family: 宋体;\">能够精确地计算传动比</span></p>"},{"l":"B","c":"<p><span style=\"font-family: 宋体;\">能够有缓冲作用保护机械</span></p>"},{"l":"C","c":"<p><span style=\"font-family: 宋体;\">适合近距离传动</span></p>"},{"l":"D","c":"<p><span style=\"font-family: 宋体;\">适合远距离传动</span></p>"}],"a":"A,C","an":"<p><br></p>","sc":4.0,"kp":["齿轮组变速比例的计算","齿轮和齿轮比的概念"]},{"i":"1971464278850433025","no":5,"t":4,"s":"<p><strong>二、实际操作(共1题，共80分)</strong></p><p><span style=\"font-family: 宋体;\">5. </span></p><p><span style=\"font-family: 宋体;\">搭建说明：</span></p><p><span style=\"font-family: 宋体;\">请考生制作一个奇怪的时钟模型。</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">搭建要求：</span></p><p><span style=\"font-family: 宋体;\">(a) 具备奇怪的时钟模型大体框架；</span></p><p><span style=\"font-family: 宋体;\">(b) 具备多级齿轮传动，具备同轴齿轮；</span></p><p><span style=\"font-family: 宋体;\">(c) 具备手摇把手，具备用于表示时针分针的部件；</span></p><p><span style=\"font-family: 宋体;\">(d) 缓慢旋转手摇把手，两指针旋转，且转向相同，转速不同；</span></p><p><span style=\"font-family: 宋体;\">(e) 整体动作流畅。</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">评分项：</span></p><p><span style=\"font-family: 宋体;\">1. 整体框架（40分）</span></p><p><span style=\"font-family: 宋体;\">(1) 作品零件结构和样例模型基本一致，结构完整；（20分）</span></p><p><span style=\"font-family: 宋体;\">(2) 作品相应部件固定可靠；（10分）</span></p><p><span style=\"font-family: 宋体;\">(3) 作品整体协调美观。（10分）</span></p><p><span style=\"font-family: 宋体;\">2. 动力传递/表现形式（30分）</span></p><p><span style=\"font-family: 宋体;\">(1) 完整实现题目要求的动作；（15分）</span></p><p><span style=\"font-family: 宋体;\">(2) 作品整体动作顺利流畅。（15分）</span></p><p><span style=\"font-family: 宋体;\">3. 完成时间（10分）</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">器材说明：</span></p><p><span style=\"font-family: 宋体;\">考生作答时不指定任何器材，所搭建的模型在外形、结构、功能方面满足题目要求即可。以下样例模型选自经中国电子学会评审通过的青少年机器人技术等级考试一级、二级适用器材。仅供参考，不作为考试评分的唯一依据。</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">案例样图：</span></p><p><span style=\"font-family: 宋体;\">以下列举了相关器材模型样例，考生可任选其一作为参考。</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例1</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-09-26/8659804079700254720.jpg\" alt=\"样例1.jpg\" data-href=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-09-26/8659804079700254720.jpg\" style=\"\"></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例2</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-09-26/8659804160482549760.jpg\" alt=\"样例2.jpg\" data-href=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-09-26/8659804160482549760.jpg\" style=\"\"></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例3</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-09-26/8659804484844855296.jpg\" alt=\"样例3.jpg\" data-href=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-09-26/8659804484844855296.jpg\" style=\"\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例4</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-09-26/8659804541837058048.jpg\" alt=\"样例4.jpg\" data-href=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-09-26/8659804541837058048.jpg\" style=\"\"></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例5</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-09-26/8659804602553802752.jpg\" alt=\"样例5.jpg\" data-href=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-09-26/8659804602553802752.jpg\" style=\"\"><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例6</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-09-26/8659804665434808320.jpg\" alt=\"样例6.jpg\" data-href=\"https://minio.liankexue.cn/npsc-common-bucket/default/2025-09-26/8659804665434808320.jpg\" style=\"\"><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p> </p>","o":[],"a":"","an":"<p><span style=\"font-family: 宋体;\">二、评分说明</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">1. 整体框架（40分）</span></p><p><span style=\"font-family: 宋体;\">(1) 作品零件结构是否和样例模型基本一致、结构完整，具备①奇怪的时钟大体框架、②同轴齿轮、③时针和分针（缺一不可）、④手摇把手，以上每缺少一点扣10分，缺少两点及两点以上扣20分。（20分）</span></p><p><span style=\"font-family: 宋体;\">(2) 作品相应部件的固定可靠程度；（10分）</span></p><p><span style=\"font-family: 宋体;\">(3) 作品的整体协调性和美观性。（10分）</span></p><p><span style=\"font-family: 宋体;\">2. 动力传递/表现形式（30分）</span></p><p><span style=\"font-family: 宋体;\">(1) 缓慢旋转手摇把手，两个针旋转，且转向相同，转速不同；（15分）</span></p><p><span style=\"font-family: 宋体;\">(2) 作品整体动作顺利流畅。（15分）</span></p><p><span style=\"font-family: 宋体;\">3. 完成时间（10分）</span></p><p><span style=\"font-family: 宋体;\">在考试时间内完成得10分，超时1分钟扣1分。（10分）</span></p><p><span style=\"font-family: 宋体;\">超时10分钟以上不结束操作总成绩记为0分。</span></p>","sc":80.0,"kp":["齿轮组变速比例的计算","齿轮和齿轮比的概念"]}]