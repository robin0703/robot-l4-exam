[{"i":"1815306874446467073","no":1,"t":2,"s":"<p><span style=\"font-family: 宋体;\">请查看第二大题“实际操作”再进行本题作答</span></p><p><span style=\"font-family: 宋体;\">使用下列工具属于使用省力杠杆的是？（ ）</span></p>","o":[{"l":"A","c":"<p><span style=\"font-family: 宋体;\">筷子</span></p>"},{"l":"B","c":"<p><span style=\"font-family: 宋体;\">钓鱼竿</span></p>"},{"l":"C","c":"<p><span style=\"font-family: 宋体;\">撬棍</span></p>"},{"l":"D","c":"<p><span style=\"font-family: 宋体;\">扳手</span></p>"}],"a":"C,D","an":"<p><br></p>","sc":4.0,"kp":["省力杠杆和费力杠杆","六种简单机械原理（杠杆，轮轴，滑轮，斜面，楔，螺旋）"]},{"i":"1815307123492036609","no":2,"t":2,"s":"<p><span style=\"font-family: 宋体;\">关于杠杆说法正确的是？（ ）</span></p>","o":[{"l":"A","c":"<p><span style=\"font-family: 宋体;\">跷跷板是杠杆的应用</span></p>"},{"l":"B","c":"<p><span style=\"font-family: 宋体;\">杠杆支点的位置可以在动力作用点和阻力作用点之间</span></p>"},{"l":"C","c":"<p><span style=\"font-family: 宋体;\">杠杆的动力臂一定大于阻力臂</span></p>"},{"l":"D","c":"<p><span style=\"font-family: 宋体;\">所有杠杆都是省力的</span></p>"}],"a":"A,B","an":"<p><br></p>","sc":4.0,"kp":["省力杠杆和费力杠杆","六种简单机械原理（杠杆，轮轴，滑轮，斜面，楔，螺旋）"]},{"i":"1815307517316210690","no":3,"t":2,"s":"<p><span style=\"font-family: 宋体;\">跷跷板中不存在下列哪些机械结构？（ ）</span></p>","o":[{"l":"A","c":"<p><span style=\"font-family: 宋体;\">滑轮</span></p>"},{"l":"B","c":"<p><span style=\"font-family: 宋体;\">斜面</span></p>"},{"l":"C","c":"<p><span style=\"font-family: 宋体;\">杠杆</span></p>"},{"l":"D","c":"<p><span style=\"font-family: 宋体;\">轮轴</span></p>"}],"a":"A,B,D","an":"<p><br></p>","sc":4.0,"kp":["六种简单机械原理（杠杆，轮轴，滑轮，斜面，楔，螺旋）"]},{"i":"1815307657389187073","no":4,"t":2,"s":"<p><span style=\"font-family: 宋体;\">下列能增强模型基座稳定性的做法有哪些？（ ）</span></p>","o":[{"l":"A","c":"<p><span style=\"font-family: 宋体;\">支点采用三角形结构</span></p>"},{"l":"B","c":"<p><span style=\"font-family: 宋体;\">让支点与地面的接触面积增大</span></p>"},{"l":"C","c":"<p><span style=\"font-family: 宋体;\">支点采用四边形结构</span></p>"},{"l":"D","c":"<p><span style=\"font-family: 宋体;\">让支点与地面的接触面积减小</span></p>"}],"a":"A,B","an":"<p><br></p>","sc":4.0,"kp":["稳定结构和不稳定结构的特性","基本结构认知"]},{"i":"1815308255052341249","no":5,"t":4,"s":"<p><span style=\"font-family: 宋体;\">二</span>、实际操作(共1题，共80分)</p><p><span style=\"font-family: 宋体;\">5. </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">搭建说明：</span></p><p><span style=\"font-family: 宋体;\">请考生制作一个跷跷板模型。</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">搭建要求：</span></p><p><span style=\"font-family: 宋体;\">(a) 具备跷跷板模型大体框架，有表示座椅的部件；</span></p><p><span style=\"font-family: 宋体;\">(b) 跷跷板的支点要求有很好的稳定性；</span></p><p><span style=\"font-family: 宋体;\">(c) 跷跷板两侧一样长；</span></p><p><span style=\"font-family: 宋体;\">(d) 能流畅地绕着支点上下摆动。</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">评分项：</span></p><p><span style=\"font-family: 宋体;\">1.整体框架（40分）</span></p><p><span style=\"font-family: 宋体;\">(1) 作品零件结构和样例模型基本一致，结构完整；（20分）</span></p><p><span style=\"font-family: 宋体;\">(2) 作品相应部件固定可靠；（10分）</span></p><p><span style=\"font-family: 宋体;\">(3) 作品整体协调美观。（10分）</span></p><p><span style=\"font-family: 宋体;\">2.动力传递/表现形式（30分）</span></p><p><span style=\"font-family: 宋体;\">(1) 完整实现题目要求的动作；（15分）</span></p><p><span style=\"font-family: 宋体;\">(2) 作品整体动作顺利流畅。（15分）</span></p><p><span style=\"font-family: 宋体;\">3.完成时间（10分）</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">器材说明：</span></p><p><span style=\"font-family: 宋体;\">考生作答时不指定任何器材，所搭建的模型在外形、结构、功能方面满足题目要求即可。以下样例模型选自经中国电子学会评审通过的青少年机器人技术等级考试一级、二级适用器材。仅供参考，不作为考试评分的唯一依据。</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\">案例样图：</span></p><p><span style=\"font-family: 宋体;\">以下列举了相关器材模型样例，考生可任选其一作为参考。</span></p><p><span style=\"font-family: 宋体;\"> </span></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例1</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2024-07-22-16-48-16/样例1.jpg?sign=8503648882167865344\" alt=\"\" data-href=\"\" style=\"\"></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例2</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2024-07-22-16-48-22/样例2.jpg?sign=8503648906717126656\" alt=\"\" data-href=\"\" style=\"\"></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例3</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2024-07-22-16-48-38/样例3.jpg?sign=8503648973091987456\" alt=\"\" data-href=\"\" style=\"\"></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例4</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2024-07-22-16-48-52/样例4.jpg?sign=8503649033007620096\" alt=\"\" data-href=\"\" style=\"\"></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例5</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2024-07-22-16-49-04/样例5.jpg?sign=8503649083251187712\" alt=\"\" data-href=\"\" style=\"\"></p><p style=\"text-align: center;\"><span style=\"font-family: 宋体;\">样例6</span></p><p style=\"text-align: center;\"><img src=\"https://minio.liankexue.cn/npsc-common-bucket/default/2024-07-22-16-49-17/样例6.jpg?sign=8503649135948423168\" alt=\"\" data-href=\"\" style=\"\"></p><p><img src=\"file:///C:\\Users\\ADMINI~1\\AppData\\Local\\Temp\\ksohtml13480\\wps5.png\" alt=\"\" data-href=\"\" style=\"\"/><span style=\"font-family: 宋体;\"> </span></p><p><span style=\"font-family: 宋体;\"> </span></p>","o":[],"a":"","an":"<p><strong>评分说明</strong></p><p style=\"text-indent: 7.05pt;\"><strong>1、整体框架（40分）</strong></p><p style=\"text-indent: 28pt;\"><span style=\"font-family: 宋体;\">(1)</span> <span style=\"font-family: 宋体;\">作品零件结构是否和样例模型基本一致、结构完整，具备①支点、②两侧表示座椅的部件、③等臂的杠杆，以上每缺少一点扣10分，缺少两点及两点以上扣20分（20分）<br> &nbsp; &nbsp;(2)作品相应部件的固定可靠程度；（10分）</span></p><p style=\"text-indent: 28pt;\"><span style=\"font-family: 宋体;\">(3)作品的整体协调性和美观性。（10分）</span></p><p style=\"text-indent: 28.1pt;\"><strong>2、动力传递/表现形式（30分）</strong></p><p style=\"text-indent: 28pt;\"><span style=\"font-family: 宋体;\">(1)给跷跷板施力它能流畅地绕着支点上下摆动；（15分）</span></p><p style=\"text-indent: 28pt;\"><span style=\"font-family: 宋体;\">(2)作品整体动作顺利流畅。（15分）</span></p><p style=\"text-indent: 28.1pt;\"><strong>3、完成时间（10分）</strong></p><p style=\"text-indent: 28pt;\"><span style=\"font-family: 宋体;\">在考试时间内完成得10分，超时1分钟扣1分。（10分）</span></p><p style=\"text-indent: 28pt;\"><span style=\"color: rgb(255, 0, 0); font-family: 宋体;\">超时10分钟以上不结束操作总成绩记为0分。</span></p>","sc":80.0,"kp":["省力杠杆和费力杠杆","六种简单机械原理（杠杆，轮轴，滑轮，斜面，楔，螺旋）","稳定结构和不稳定结构的特性"]}]