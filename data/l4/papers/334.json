\"><o:p></o:p></span></pre><pre><span lang=\"EN-US\">}<o:p></o:p></span></pre><pre><span lang=\"EN-US\">void</span><span lang=\"EN-US\"> </span><span lang=\"EN-US\">loop</span><span lang=\"EN-US\">() {<o:p></o:p></span></pre><pre><span lang=\"EN-US\"> &nbsp;</span><span lang=\"EN-US\">if</span><span lang=\"EN-US\"> (irrecv</span><span lang=\"EN-US\">.</span><span lang=\"EN-US\">decode</span><span lang=\"EN-US\">(</span><span lang=\"EN-US\">&amp;</span><span lang=\"EN-US\">results)) {&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;<o:p></o:p></span></pre><pre><span lang=\"EN-US\">&nbsp;&nbsp;&nbsp;&nbsp;</span><b><span lang=\"EN-US\">Serial</span></b><span lang=\"EN-US\">.</span><span lang=\"EN-US\">println</span><span lang=\"EN-US\">(results</span><span lang=\"EN-US\">.</span><span lang=\"EN-US\">value</span><span lang=\"EN-US\">,</span><span lang=\"EN-US\"> </span><span lang=\"EN-US\">HEX</span><span lang=\"EN-US\">); &nbsp;<o:p></o:p></span></pre><pre><span lang=\"EN-US\">&nbsp;&nbsp;&nbsp;&nbsp;irrecv</span><span lang=\"EN-US\">.</span><span lang=\"EN-US\">resume</span><span lang=\"EN-US\">();&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;<o:p></o:p></span></pre><pre><span lang=\"EN-US\">&nbsp;&nbsp;}<o:p></o:p></span></pre><p class=\"MsoNormal\">\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<span lang=\"EN-US\"> &nbsp;</span><span lang=\"EN-US\">delay</span><span lang=\"EN-US\">(100);</span></p><p class=\"MsoNormal\"><span lang=\"EN-US\"><br></span></p>\r\n\r\n<p class=\"MsoNormal\">原器件： <span lang=\"EN-US\"><o:p></o:p></span></p>\r\n\r\n<p class=\"MsoNormal\">（<span lang=\"EN-US\">1</span>）装置中包含<span lang=\"EN-US\">2</span>个<span lang=\"EN-US\">LED</span>灯模块或<span lang=\"EN-US\">LED</span>灯；（<span lang=\"EN-US\">4</span>分）<span lang=\"EN-US\"